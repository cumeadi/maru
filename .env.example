# ─────────────────────────────────────────────────────────────────────────────
# Maru — Environment Variables
# Copy this file to .env and fill in your values before running docker-compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (required) ──────────────────────────────────────────────────
# Used by the LLM-as-a-Judge engine (via LiteLLM).
# Provide at least one key depending on which judge model you want to use.

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Default judge model. Options: gpt-4o, claude-3-5-sonnet-20241022, gemini/gemini-1.5-pro
JUDGE_MODEL=gpt-4o

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string. Matches the docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://maru:marupass@postgres:5432/marudb

# For local dev without Docker, point to your local Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/marudb

# ── Engine API ───────────────────────────────────────────────────────────────
# Secret used to validate Bearer tokens on all /api/v1/* routes.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
MARU_API_SECRET=change-me-in-production

# ── Telemetry / Alerting (optional) ─────────────────────────────────────────
# Slack incoming webhook URL for drift detection alerts.
# Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Drift threshold — alert if rolling alignment drops below this value (0-100).
DRIFT_ALERT_THRESHOLD=85.0

# ── SDK (for local testing against a running engine) ─────────────────────────
MARU_API_KEY=your-maru-api-key
MARU_BASE_URL=http://localhost:8000
